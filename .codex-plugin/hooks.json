{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.PLUGIN_ROOT + '/.codex-plugin/session-start.cjs')\"",
            "timeout": 10,
            "statusMessage": "Loading Superpowers workflow choices"
          }
        ]
      }
    ]
  }
}
